# 复制为 .env 后按需填写。此文件不会被 Git 提交。

# 本地 SQLite
APP_DATA_DIR=./data
SERVER_PORT=8080

# 本地头像/文件存储；默认位于 APP_DATA_DIR/storage。
APP_STORAGE_LOCAL_ROOT=./data/storage
# 自托管 DiceBear API。Java 后端不访问 DiceBear 公共服务。
APP_AVATAR_GENERATOR_BASE_URL=http://localhost:3100
APP_AVATAR_GENERATOR_CONNECT_TIMEOUT=500ms
APP_AVATAR_GENERATOR_READ_TIMEOUT=1500ms
APP_AVATAR_GENERATOR_MAX_RESPONSE_BYTES=262144

# 所有 HTTP 响应携带的展示标识；两项都只允许单行、最长 128 字符。
APP_RESPONSE_POWERED_BY=ASP.NET
APP_RESPONSE_SERVER=Microsoft-IIS/10.0

# 第一次启动时创建超级管理员；留空则不创建。
APP_BOOTSTRAP_ADMIN_USERNAME=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# 仅在明确需要恢复本地管理员时设为 true；正常情况下保持 false。
APP_BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# JWT：local 默认可临时生成密钥；生产 postgres profile 必须同时提供私钥和公钥。
# 可直接填 PEM（换行写为 \n），或使用下列文件路径。不要把真实密钥提交到 Git。
APP_JWT_PRIVATE_KEY_PEM=
APP_JWT_PUBLIC_KEY_PEM=
APP_JWT_PRIVATE_KEY_PATH=
APP_JWT_PUBLIC_KEY_PATH=
# 不要在 .env 中设置 APP_JWT_ALLOW_EPHEMERAL_KEY；local 默认允许临时密钥，postgres 默认拒绝。

# 本地 SQL Console 默认关闭；仅在 local profile 下显式设为 true 才可使用。
APP_SQL_CONSOLE_ENABLED=false

# Refresh Cookie 在 postgres profile 默认启用 Secure；仅纯 HTTP 本地开发可设为 false。
APP_AUTH_REFRESH_COOKIE_SECURE=true

# 允许携带凭据访问 API 的前端来源，逗号分隔；生产环境禁止使用 *。
APP_SECURITY_CORS_ALLOWED_ORIGINS=

# 仅当直连来源属于这些 CIDR/IP 时，才解析 X-Forwarded-For。
APP_SECURITY_TRUSTED_PROXIES=

# PostgreSQL profile（启动时使用 SPRING_PROFILES_ACTIVE=postgres）
DB_URL=jdbc:postgresql://localhost:5432/starter
DB_USERNAME=starter
DB_PASSWORD=change-me-before-use

# Compose 使用
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=change-me-before-use
APP_PORT=8080
